#!/usr/bin/env bash
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)

joblog_json=$1
cmd=$2
precmd=$3
postcmd=$4
object=$5
source=$6
#Escapes # as \#
source="${source//\\#/#}"
#Escapes $ as DOLLARESCAPE_
source="${source/DOLLARESCAPE_/$}"
output=$7
text_command=$8
VPATH=$9
temp_file=${10}
procedure_stamp=${11}

objectExists="false"
shouldProcess="true"

IFS=":"
for dir in $VPATH;
do
  if [[ -e "$dir/$object" ]]; then
    objectExists="true"
  fi
done

if [[ -n "$procedure_stamp" ]]; then
  # For a registration, the validated catalog-backed stamp replaces the QSYS object.
  objectExists="false"
  [[ -e "$procedure_stamp" ]] && objectExists="true"
  # A failed or interrupted registration must be retried, even if some SQL succeeded.
  rm -f -- "$procedure_stamp" || exit 1
fi

while read -r line; do
  if [[ "$line" == *"{"* ]]; then
    if [[ "$objectExists" = "false" ]]; then
      shouldProcess="false"
    fi 
    continue
  elif [[ "$line" == *"}"* ]]; then
    if [[ "$objectExists" = "false" ]]; then
      shouldProcess="true"
      continue
    else
      break
    fi
  fi

  if [[ "$shouldProcess" = "true" ]]; then
      echo "$line" >> $temp_file
  fi
done < <(grep "" $source)

"$SCRIPT_DIR"/launch "$joblog_json" "$cmd" "$precmd" "$postcmd" "$object" "$source" "$output" "" "$text_command"
status=$?
if [[ -n "$procedure_stamp" ]]; then
  rm -f -- "$temp_file"
  [[ $status -eq 0 ]] || exit "$status"
  PYTHONPATH="${SCRIPT_DIR}/..":${PYTHONPATH} /QOpenSys/pkgs/bin/python3.9 -m makei.sql_procedure \
    "$tmpCurlib" "${object%.PROCEDURE}" "$procedure_stamp"
  exit $?
fi
exit "$status"
